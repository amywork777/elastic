{
  "name": "@workbench/core",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Prompt-context contracts and file-format tables shared by the app and @workbench/ui.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/*": "./dist/lib/*",
    "./package.json": "./package.json",
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js"
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
